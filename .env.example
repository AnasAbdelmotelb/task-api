DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# Supabase Auth (Project Settings -> API). Use the anon/public key only,
# never the service_role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Comma-separated allowlist of emails permitted to call /protected/admin.
# Optional; leave blank to disable the admin route for everyone.
ADMIN_EMAILS=admin@example.com

# LLM provider (BE-07 /tasks/classify). These three values are the only
# difference between a local model and a hosted one.
# Local Ollama (default): the key is the literal string "ollama" and is ignored.
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# Seconds to wait for the model (above 0, at most 60). Defaults to 30.
LLM_TIMEOUT_SECONDS=30
# OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=YOUR_OPENROUTER_KEY   LLM_MODEL=openrouter/free
# Model URL used inside Docker Compose ("localhost" there is the container).
# The default reaches Ollama on the host; for OpenRouter set the URL above.
LLM_DOCKER_BASE_URL=http://host.docker.internal:11434/v1/

# Kill switch: false skips the model and returns a safe fallback answer.
LLM_ENABLED=true
# 1 returns a fixed schema-valid answer without calling the model.
LLM_STUB=0
